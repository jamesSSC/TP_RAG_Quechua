# Copiar a .env y completar. El archivo .env no se versiona.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quechua_wanka
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen3.5:4b

# Umbral recalibrado sobre esta implementacion (ver scripts/calibrar_umbral.py)
UMBRAL_ABSTENCION=0.48
FRAGMENTOS_RECUPERADOS=5

CORS_ORIGENES=http://localhost:5173

# Motor de persistencia: sqlite (defecto) o postgres. Con postgres el historial se escribe y
# se agrega mediante los procedimientos almacenados de db/postgres/procedimientos.sql.
BASE_DATOS=sqlite

# PMV2 · cortes de los modelos predictivos (ver modelos/metricas.json)
PROBABILIDAD_MINIMA_COBERTURA=0.25
PROBABILIDAD_MINIMA_PASAJES=0.50

# Traduccion EN->ES de la consulta: tabla (defecto, tambien en la nube) u ollama.
TRADUCTOR=tabla
# Nivel del registro: DEBUG, INFO (defecto, muestra el log por capas), WARNING o ERROR.
NIVEL_LOG=INFO

# ---------------------------------------------------------------------------------------------
# Modo nube (Render + Neon, ADR-030 a ADR-037). En local se dejan vacios o comentados.
# En Render se cargan en el panel (sync: false en render.yaml) y NUNCA se versionan.
# ---------------------------------------------------------------------------------------------
# ENTORNO distinto de "local" activa el token de administracion, el limite por IP y HSTS.
# ENTORNO=staging
# CORPUS_ORIGEN=postgres
# DATABASE_URL=
# GENERADOR=gemini
# GEMINI_API_KEY=
# GEMINI_MODELO=gemini-3.5-flash-lite
# CORS_ORIGENES=https://quechua-web.onrender.com
# Token para las escrituras (incorporar, editar o borrar fuentes; borrar historial). ADR-035.
# ADMIN_TOKEN=
# Token que marca las pruebas como origen humo/carga/arnes (HU-09) y las exime del limite.
# TOKEN_PRUEBAS=
# Limites por IP y minuto en modo nube (ADR-037); 0 desactiva.
# LIMITE_CONSULTAS_POR_MINUTO=20
# LIMITE_PREDICCIONES_POR_MINUTO=60
