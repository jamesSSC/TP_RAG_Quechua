@startuml
!include common.iuml
title Diagrama de casos de uso
left to right direction
actor "Docente / estudiante EIB\n(usuario público)" as U
actor "Administrador\n(X-Admin-Token en la nube)" as A
actor "Equipo de desarrollo\n(fuera de línea)" as D
A -|> U
rectangle "Asistente de consulta del quechua wanka" {
  usecase "Consultar el corpus\n(HU-03, 04, 05, 06, 07)" as UC1
  usecase "Ver la predicción ML\n(HU-08.1, RF-15)" as UC2
  usecase "Ver la analítica de demanda\n(HU-09)" as UC3
  usecase "Consultar el historial\n(RF-11)" as UC4
  usecase "Gestionar fuentes y licencias\n(HU-01)" as UC5
  usecase "Incorporar un PDF\n(HU-01, HU-02)" as UC6
  usecase "Reindexar el corpus\n(RF-13)" as UC7
  usecase "Borrar el historial" as UC8
  usecase "Declarar ausencia de respaldo\n(RN-01, RN-09)" as UC9
  usecase "Entrenar predictores y\nexportar el índice móvil" as UC10
}
U --> UC1
U --> UC2
U --> UC3
U --> UC4
UC9 .> UC1 : <<extend>>\n[similitud < τ]
A --> UC5
A --> UC6
A --> UC7
A --> UC8
UC6 .> UC5 : <<include>>
D --> UC10
@enduml
