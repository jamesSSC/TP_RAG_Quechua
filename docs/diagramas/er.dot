digraph ER { rankdir=LR; node[shape=plain,fontname="DejaVu Sans",fontsize=10]; edge[fontname="DejaVu Sans",fontsize=9];
 label="Modelo físico de la base de datos (SQLite / PostgreSQL)"; labelloc=t; fontsize=13; fontname="DejaVu Sans";
 consultas [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1F3864"><font color="white"><b>consultas</b></font></td></tr>
 <tr><td align="left">PK id VARCHAR(36)</td></tr><tr><td align="left">texto TEXT</td></tr><tr><td align="left">idioma VARCHAR(2)</td></tr><tr><td align="left">texto_traducido TEXT NULL</td></tr><tr><td align="left">momento TIMESTAMPTZ</td></tr><tr><td align="left">respuesta_texto TEXT</td></tr><tr><td align="left">abstenida BOOLEAN (índice)</td></tr><tr><td align="left">similitud_maxima FLOAT</td></tr><tr><td align="left">via_respaldo VARCHAR(10) NULL</td></tr>
 <tr><td align="left" bgcolor="#FFF6E5">probabilidad_cobertura FLOAT · PMV2</td></tr><tr><td align="left" bgcolor="#FFF6E5">probabilidad_pasajes FLOAT · PMV2</td></tr><tr><td align="left" bgcolor="#FFF6E5">abstencion_por_predictor BOOLEAN · PMV2</td></tr><tr><td align="left" bgcolor="#FFF6E5">pasajes_ofrecidos INTEGER · PMV2</td></tr><tr><td align="left" bgcolor="#FFF6E5">latencia_ms FLOAT · PMV2</td></tr></table>>];
 respaldos [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1F3864"><font color="white"><b>respaldos</b></font></td></tr>
 <tr><td align="left">PK id INTEGER</td></tr><tr><td align="left">FK consulta_id → consultas.id (CASCADE)</td></tr><tr><td align="left">fragmento_id VARCHAR(64)</td></tr><tr><td align="left">documento VARCHAR(300)</td></tr><tr><td align="left">pagina INTEGER</td></tr><tr><td align="left">texto TEXT</td></tr><tr><td align="left">puntuacion FLOAT</td></tr><tr><td align="left">derivado_ocr BOOLEAN</td></tr></table>>];
 fuentes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1F3864"><font color="white"><b>fuentes</b></font></td></tr>
 <tr><td align="left">PK id VARCHAR(36)</td></tr><tr><td align="left">titulo VARCHAR(300)</td></tr><tr><td align="left">entidad_publicadora VARCHAR(200)</td></tr><tr><td align="left">licenciamiento VARCHAR(300)</td></tr><tr><td align="left">fecha_extraccion DATE</td></tr><tr><td align="left">nombre_archivo VARCHAR(300)</td></tr><tr><td align="left">paginas_totales / paginas_con_texto INTEGER</td></tr><tr><td align="left">derivado_ocr BOOLEAN</td></tr></table>>];
 sp [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FDECEA"><tr><td><b>Procedimientos almacenados (PostgreSQL)</b></td></tr><tr><td align="left">sp_registrar_consulta(…, p_respaldos JSONB)</td></tr><tr><td align="left">sp_borrar_historial(INOUT p_borradas)</td></tr><tr><td align="left">fn_resumen_demanda()</td></tr><tr><td align="left">fn_respaldo_por_documento()</td></tr><tr><td align="left">fn_demanda_insatisfecha(p_limite)</td></tr></table>>];
 consultas -> respaldos [label="1 : 0..k", arrowhead=crow];
 sp -> consultas [style=dashed,label="escribe / agrega"];
}
